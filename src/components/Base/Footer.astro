---
import { HeartIcon } from "lucide-react";

import { IJCharacter } from "@/components/ui/ichigojam";

const currentYear = new Date().getFullYear();
---

<footer class="border-t-4 border-border mt-auto">
  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <h3 class="font-bold text-lg border-b-2 border-accent pb-1">
          <IJCharacter characterCodes="ABOUT THIS SITE" />
        </h3>
        <p class="text-sm text-muted-foreground">
          技術的な知見や日々の学びを共有するブログです。
        </p>
      </div>

      <div class="space-y-4">
        <h3 class="font-bold text-lg border-b-2 border-accent pb-1">
          <IJCharacter characterCodes="NAVIGATION" />
        </h3>
        <nav>
          <ul class="space-y-2 text-sm">
            <li>
              <a href="/" class="hover:text-accent transition-colors">ホーム</a>
            </li>
            <li>
              <a href="/blog" class="hover:text-accent transition-colors">
                ブログ一覧
              </a>
            </li>
            <li>
              <a href="/license" class="hover:text-accent transition-colors">
                ライセンス情報
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div
      class="mt-8 pt-6 border-t-2 border-border text-center text-sm text-muted-foreground"
    >
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2">
        <span class="flex items-center gap-1">
          Made with <HeartIcon size={16} className="text-destructive" /> by 國友大睦
          (hiromu kunitomo)
        </span>
        <span class="hidden sm:inline">•</span>
        <span>© {currentYear} All rights reserved</span>
      </div>
      <div class="mt-2">
        <span class="text-xs">
          本サイトのコンテンツは
          <a
            href="https://creativecommons.org/licenses/by/4.0/deed.ja"
            target="_blank"
            rel="license noopener noreferrer"
            class="hover:text-accent transition-colors"
          >
            CC BY 4.0
          </a>
          のもとで提供されています（
          <a href="/license" class="hover:text-accent transition-colors">
            詳細
          </a>
          ）
        </span>
      </div>
    </div>
  </div>
</footer>
