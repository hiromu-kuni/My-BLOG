---
import "@/styles/global.css";

import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";

import Footer from "@/components/Base/Footer.astro";
import Header from "@/components/Base/Header.astro";
import JsonLd from "@/components/SEO/JsonLd.astro";
import ClickShatterBlock from "@/components/ui/click-shatter-block";

export type Props = {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
};

const {
  title = "ひろむのブログ - Hiromu's Blog",
  description = "ひろむの技術ブログ。IchigoJamやプログラミング、Web開発に関する記事を発信しています。",
  image = "/ogp.png",
  canonical,
} = Astro.props as Props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const fullImageUrl = new URL(image, Astro.site).href;
---

<script is:inline>
  document.documentElement.classList.add("dark");

  document.addEventListener("astro:before-swap", (ev) => {
    ev.newDocument.documentElement.classList.add("dark");
  });
</script>

<html lang="ja" class="scroll-smooth dark">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          type: "website",
          url: canonicalURL,
          title: title,
          image: fullImageUrl,
        },
        optional: {
          description: description,
          siteName: "ひろむのブログ - Hiromu's Blog",
          locale: "ja_JP",
        },
        image: {
          alt: "Hiromu's Blog | ひろむのブログ",
        },
      }}
      twitter={{
        card: "summary_large_image",
        creator: "@hiromu_kunitomo",
        title: title,
        description: description,
        image: fullImageUrl,
        imageAlt: "Hiromu's Blog | ひろむのブログ",
      }}
    />

    <JsonLd
      schema={{
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "ひろむのブログ - Hiromu's Blog",
        description: description,
        url: canonicalURL,
        author: {
          "@type": "Person",
          name: "國友大睦 (hiromu kunitomo)",
          url: canonicalURL,
        },
        inLanguage: "ja",
      }}
    />

    <slot name="head" />

    <!-- IchigoJamフォントのプリロード -->
    <link
      rel="preload"
      href="/fonts/IchigoJam-1.4.woff"
      as="font"
      type="font/woff"
      crossorigin="anonymous"
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body class="border-4">
    <ClickShatterBlock client:load>
      <Header transition:persist />
      <main transition:animate="fade">
        <slot />
      </main>
      <Footer />
    </ClickShatterBlock>
  </body>
</html>

<style>
  /* アクセシビリティ: モーション設定を尊重 */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
